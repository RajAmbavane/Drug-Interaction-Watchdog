# Copy to .env and fill in. Never commit the real .env.

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# ── Supabase (auth + patient memory) ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── LLM providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Data ingestion ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drugwatchdog
NCBI_API_KEY=

# ── Alert delivery (optional) ─────────────────────────────────────────────────
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_WEBHOOK_URL=
PHARMACIST_EMAILS=
PHYSICIAN_EMAILS=
